rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // The caller's own user document. Firestore caches document reads within a
    // single rule evaluation, so calling this more than once per rule costs one
    // read, not several.
    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (callerDoc().role == 'ADMIN' || callerDoc().get('isSuperUser', false) == true);
    }

    // Fields an update leaves changed.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ─── Users ─────────────────────────────────────────────────────
    //
    // PRIVATE. Holds email and other contact data, so only the owner and admins
    // may read it. Public-facing name/avatar are denormalized into the
    // `talents` / `venues` docs for the marketplace (see S3 in ACTION_PLAN.md).
    //
    // `role` and `isSuperUser` are what isAdmin() reads, so a user who could
    // write them could promote themselves to admin and then read every user's
    // identity documents and payout data. They are immutable except by an admin.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
                    && request.resource.data.get('role', '') != 'ADMIN'
                    && request.resource.data.get('isSuperUser', false) == false;

      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.get('role', '') == resource.data.get('role', '')
                        && request.resource.data.get('isSuperUser', false)
                           == resource.data.get('isSuperUser', false));
    }

    // ─── Role-specific profiles ────────────────────────────────────

    match /artists/{userId} {
      allow read: if isAuth();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /clients/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    match /talents/{userId} {
      allow read: if true; // Public for marketplace
      allow write: if isOwner(userId) || isAdmin();
    }

    // Venue docs are keyed by the owner's uid (see createVenueProfile), so the
    // document id itself is the ownership check.
    match /venues/{venueId} {
      allow read: if true; // Public for event creation & marketplace
      allow create: if (isOwner(venueId) && request.resource.data.userId == venueId)
                    || isAdmin();
      allow update: if (isOwner(venueId) && request.resource.data.userId == resource.data.userId)
                    || isAdmin();
      allow delete: if isOwner(venueId) || isAdmin();
    }

    // ─── Events ────────────────────────────────────────────────────
    //
    // Public read. The organizer is bound at creation and immutable afterwards,
    // so an event can never be attributed to another user.
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.organizerId == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuth()
                        && resource.data.organizerId == request.auth.uid
                        && request.resource.data.organizerId == resource.data.organizerId);
      allow delete: if (isAuth() && resource.data.organizerId == request.auth.uid) || isAdmin();
    }

    // ─── Bookings ──────────────────────────────────────────────────
    //
    // Personal calendar slots — single-party, no counterparty involved.
    match /bookings/{bookingId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if (isAuth() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // ─── Conversations ─────────────────────────────────────────────
    //
    // Only participants may read or write, and the participant list is frozen
    // after creation so nobody can add themselves to someone else's thread.
    match /conversations/{convoId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuth() && request.auth.uid in
          get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow create: if isAuth() && request.auth.uid in
          get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
      }
    }

    // ─── Notifications ─────────────────────────────────────────────
    //
    // Owner only. A user may only create notifications addressed to themselves
    // (cross-user notifications must be server-side).
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ─── Services ──────────────────────────────────────────────────

    match /services/{serviceId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
                    || (isAuth()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.userId == resource.data.userId);
      allow delete: if (isAuth() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // ─── Tickets ───────────────────────────────────────────────────

    match /tickets/{ticketId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ─── Categories ────────────────────────────────────────────────

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Audit logs ────────────────────────────────────────────────

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    // ─── Approvals ─────────────────────────────────────────────────
    //
    // A verification request always starts as `pending` and only an admin can
    // move it forward — a user cannot submit themselves pre-approved.
    match /approvals/{approvalId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin();
    }

    // ─── Wallets ───────────────────────────────────────────────────
    //
    // KNOWN LIMITATION (S1 in ACTION_PLAN.md): the balance is computed in the
    // browser, so the owner can set it to any value. Acceptable while the
    // balance is play money; must move to Cloud Functions before real funds.
    // Disclosed to the buyer in HANDOVER.md rather than hidden.
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
    }

    // ─── Contracts ─────────────────────────────────────────────────
    //
    // Only the two parties can see a contract. Once created, the commercial
    // terms (amount, escrowFee, total, the parties themselves) are frozen: an
    // update may only touch signature, payment and payout markers, and each
    // party may only touch its own side. This is what stops a talent from
    // raising the amount after the client has signed.
    match /contracts/{contractId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.talentId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuth() && (
        request.resource.data.clientId == request.auth.uid ||
        request.resource.data.talentId == request.auth.uid
      );

      allow update: if isAuth()
        && (resource.data.clientId == request.auth.uid
            || resource.data.talentId == request.auth.uid)
        && changed().hasOnly([
             'clientSignedAt', 'talentSignedAt', 'status',
             'paymentStatus', 'paymentProvider', 'paidAt',
             'talentPayoutRecorded'
           ])
        && (resource.data.clientId == request.auth.uid
            || !changed().hasAny(['clientSignedAt', 'paymentStatus', 'paymentProvider', 'paidAt']))
        && (resource.data.talentId == request.auth.uid
            || !changed().hasAny(['talentSignedAt', 'talentPayoutRecorded']));
    }

    // ─── Payout methods ────────────────────────────────────────────
    //
    // PRIVATE. Each doc keyed by uid.
    match /payoutMethods/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // ─── Reviews ───────────────────────────────────────────────────
    //
    // Public read (shown on the talent profile). A user reviews someone else,
    // never themselves, and only the reviewer can edit their own review.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth()
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.talentId != request.auth.uid
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if (isAuth() && resource.data.clientId == request.auth.uid)
                            || isAdmin();
    }

    // ─── Projects ──────────────────────────────────────────────────
    //
    // Private kanban — owner only.
    match /projects/{projectId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ─── Transactions ──────────────────────────────────────────────
    //
    // Owner only. See the wallets note above: amounts are still
    // client-controlled (S1). Ledger entries are append-only for users.
    match /transactions/{transactionId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }
  }
}
